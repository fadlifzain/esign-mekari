<div class="sign-stepper" aria-label="Signing steps">
  <% if current_step > 1 %>
    <div class="sign-step">
      <div class="sign-step__badge sign-step__badge--done" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4 10-10"></path></svg>
      </div>
      <span class="sign-step__label sign-step__label--done">Upload document</span>
    </div>
  <% else %>
    <div class="sign-step">
      <div class="sign-step__badge sign-step__badge--active" aria-current="step">1</div>
      <span class="sign-step__label sign-step__label--active">Upload document</span>
    </div>
  <% end %>

  <div class="sign-stepper__connector" aria-hidden="true"></div>

  <% if current_step == 2 %>
    <div class="sign-step">
      <div class="sign-step__badge sign-step__badge--active" aria-current="step">2</div>
      <span class="sign-step__label sign-step__label--active">Set recipients</span>
    </div>
  <% else %>
    <div class="sign-step">
      <div class="sign-step__badge sign-step__badge--todo">2</div>
      <span class="sign-step__label sign-step__label--todo">Set recipients</span>
    </div>
  <% end %>
</div>
